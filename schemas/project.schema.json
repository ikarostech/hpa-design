          "minLength": 1
        },
        "method": {
          "$ref": "#/$defs/AnalysisMethod"
        },
        "alphaStart": {
          "type": "number"
        },
        "alphaEnd": {
          "type": "number"
        },
        "alphaStep": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "altitude": {
          "type": "number"
        },
        "reynolds": {
          "type": "number"
        },
        "geometryId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AnalysisCaseStatus"
        }
      },
      "required": [
        "id",
        "name",
        "method",
        "alphaStart",
        "alphaEnd",
        "alphaStep",
        "speed",
        "altitude",
        "reynolds",
        "geometryId",
        "status"
      ],
