        },
        "aspectRatio": {
          "type": "number"
        },
        "mac": {
          "type": "number"
        },
        "staticMargin": {
          "type": "number"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WingSection"
          }
        }
      },
      "required": [
        "id",
        "span",
        "rootChord",
        "tipChord",
        "taperRatio",
        "twist",
        "dihedral",
        "sweep",
        "incidence",
        "wingArea",
        "aspectRatio",
        "mac",
        "staticMargin",
        "sections"
      ],
      "additionalProperties": false
    },
    "WingSection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "yPosition": {
          "type": "number"
        },
        "chord": {
          "type": "number"
        },
        "xOffset": {
          "type": "number"
        },
        "twist": {
          "type": "number"
        },
        "dihedral": {
          "type": "number"
        },
        "airfoilId": {
          "type": "string"
        },
        "chordwisePanels": {
          "type": "number"
        },
        "spanwisePanels": {
          "type": "number"
        },
        "chordwiseDistribution": {
          "$ref": "#/$defs/PanelDistribution"
        },
        "spanwiseDistribution": {
          "$ref": "#/$defs/PanelDistribution"
        },
        "controlSurface": {
          "type": "string",
          "description": "Preserved while control-surface geometry is moved to an explicit model."
        }
      },
      "required": [
        "id",
        "yPosition",
        "chord",
        "xOffset",
        "twist",
        "dihedral",
        "airfoilId",
        "chordwisePanels",
        "spanwisePanels",
        "chordwiseDistribution",
        "spanwiseDistribution"
      ],
      "additionalProperties": false
    },
    "PanelDistribution": {
      "type": "string",
      "enum": [
        "uniform",
        "cosine",
        "sine",
        "inverse-sine"
      ]
    },
    "AnalysisCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
