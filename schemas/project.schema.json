{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpa-design:schema:project:4",
  "title": "HPADesign project document",
  "description": "Machine-readable serialization contract for an HPADesign project file. Cross-object reference integrity is additionally checked by the application importer.",
  "$comment": "Source type: src/app/designDocument.ts#DesignDocument. Non-finite calculated values are encoded as {$hpaNumber: 'Infinity' | '-Infinity'}.",
  "$ref": "#/$defs/DesignDocument",
  "$defs": {
    "EncodedNonFiniteNumber": {
      "type": "object",
      "description": "JSON encoding used by HPADesign for a non-finite calculated number.",
      "properties": {
        "$hpaNumber": {
          "enum": [
            "Infinity",
            "-Infinity"
          ]
        }
      },
      "required": [
        "$hpaNumber"
      ],
      "additionalProperties": false
    },
    "DesignDocument": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 4,
          "description": "ファイル形式のバージョン。現在は `4` 固定。"
        },
        "name": {
          "type": "string",
          "description": "設計プロジェクトの表示名。",
          "minLength": 1
        },
        "conceptualDesign": {
          "$ref": "#/$defs/ConceptualDesign",
          "description": "設計重量、巡航速度、最大翼幅などの概要設計条件。"
        },
        "airfoils": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Airfoil"
          },
          "description": "翼型形状の一覧。"
        },
        "polars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AirfoilPolar"
          },
          "description": "翼型ごとの XFoil Polar 一覧。"
        },
        "airfoilAnalysisRuns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AirfoilAnalysisRun"
          },
          "description": "翼型解析の実行条件と結果参照。"
        },
        "aircraft": {
          "$ref": "#/$defs/AircraftGeometry",
          "description": "主翼形状と翼幅方向セクション。"
        },
        "analysisCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisCase"
          },
          "description": "LLT / VLM 空力解析ケース。"
        },
        "analysisResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisResult"
          },
          "description": "保存済み空力解析結果。"
        },
        "carbonMaterials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CarbonMaterial"
          },
          "description": "CFRP 材料特性の一覧。"
        },
        "structuralDesigns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuralDesign"
          },
          "description": "パイプ、積層、荷重ケースを含む構造設計案。"
        },
        "structuralResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuralAnalysisResult"
          },
          "description": "保存済み構造解析結果。"
        },
        "aeroelasticResults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaticAeroelasticResult"
          },
          "description": "保存済み空力・構造連成解析結果。"
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "airfoils",
        "polars",
        "airfoilAnalysisRuns",
        "aircraft",
        "analysisCases",
        "analysisResults",
        "carbonMaterials",
        "structuralDesigns",
        "structuralResults"
      ],
      "additionalProperties": false
    },
    "ConceptualDesign": {
      "type": "object",
      "properties": {
        "grossMass": {
          "type": "number"
        },
        "cruiseSpeed": {
          "type": "number"
        },
        "maximumWingspan": {
          "type": "number"
        },
        "groundHeight": {
          "type": "number"
        },
        "sustainablePower": {
          "type": "number"
        }
      },
      "required": [
        "grossMass",
        "cruiseSpeed",
        "maximumWingspan",
        "groundHeight",
        "sustainablePower"
      ],
      "additionalProperties": false
    },
    "Airfoil": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "設計プロジェクトの表示名。",
          "minLength": 1
        },
        "thicknessRatio": {
          "type": "number"
        },
        "maxCamber": {
          "type": "number"
        },
        "leadingEdgeRadius": {
          "type": "number"
        },
        "trailingEdgeThickness": {
          "type": "number"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "lower": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "upper",
              "lower"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "thicknessRatio",
        "maxCamber",
        "leadingEdgeRadius",
        "trailingEdgeThickness",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "AirfoilPolar": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "airfoilId": {
          "type": "string"
        },
        "caseName": {
          "type": "string"
        },
        "reynolds": {
          "type": "number"
        },
        "mach": {
          "type": "number"
        },
        "alphaStart": {
          "type": "number"
        },
        "alphaEnd": {
          "type": "number"
        },
        "alphaStep": {
          "type": "number"
        },
        "ncrit": {
          "type": "number"
        },
        "convergedPoints": {
          "type": "number"
        },
        "requestedPoints": {
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/PolarStatus"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alpha": {
                "type": "number"
              },
              "cl": {
                "type": "number"
              },
              "cd": {
                "type": "number"
              },
              "cm": {
                "type": "number"
              }
            },
            "required": [
              "alpha",
              "cl",
              "cd",
              "cm"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "airfoilId",
        "caseName",
        "reynolds",
        "mach",
        "alphaStart",
        "alphaEnd",
        "alphaStep",
        "ncrit",
        "convergedPoints",
        "requestedPoints",
        "status",
        "points"
      ],
      "additionalProperties": false
    },
    "PolarStatus": {
      "type": "string",
      "enum": [
        "complete",
        "needs-review"
      ]
    },
    "AirfoilAnalysisRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "設計プロジェクトの表示名。",
          "minLength": 1
        },
        "airfoilIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "polarIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "reynolds": {
          "type": "number"
        },
        "mach": {
          "type": "number"
        },
        "alphaStart": {
          "type": "number"
        },
        "alphaEnd": {
          "type": "number"
        },
        "alphaStep": {
          "type": "number"
        },
        "ncrit": {
          "type": "number"
        },
        "iterations": {
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/AirfoilAnalysisRunStatus"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "airfoilId": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "airfoilId",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "airfoilIds",
        "polarIds",
        "createdAt",
        "reynolds",
        "mach",
        "alphaStart",
        "alphaEnd",
        "alphaStep",
        "status"
      ],
      "additionalProperties": false
    },
    "AirfoilAnalysisRunStatus": {
      "type": "string",
      "enum": [
        "complete",
        "needs-review"
      ]
    },
    "AircraftGeometry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "type": "number"
        },
        "rootChord": {
          "type": "number"
        },
        "tipChord": {
